  "rules": [
    {
      "kind": "netron",
      "when": {
        "m": "dir",
        "re": "\\.mlpackage$"
      }
    },
    {
      "kind": "folder",
      "when": {
        "m": "dir",
        "re": null
      }
    },
    {
      "kind": "netron",
      "when": {
        "m": "name",
        "re": "\\.(onnx|tflite|mlmodel|keras)$"
      }
    },
    {
      "kind": "drawio",
      "when": {
        "m": "name",
        "re": "\\.(drawio|dio|drawio\\.svg|drawio\\.png)$"
      }
    },
    {
      "kind": "go",
      "when": {
        "m": "name",
        "re": "\\.sgf$"
      }
    },
    {
      "kind": "chess",
      "when": {
        "m": "name",
        "re": "\\.(pgn(\\.gz|\\.zst)?|si[45]|cbh|cbv|epd|fen|pdn|kif|kifu|csa|pbn)$"
      }
    },
    {
      "kind": "provenance",
      "when": {
        "m": "name",
        "re": "(\\.intoto\\.jsonl?|\\.sigstore(\\.json)?|\\.dsse\\.json|\\.provenance\\.json|\\.build\\.slsa|^provenance\\.json)$"
      }
    },
    {
      "kind": "bom",
      "when": {
        "m": "name",
        "re": "(\\.cdx\\.(json|xml)|\\.cbom\\.json|^bom\\.(json|xml))$"
      }
    },
    {
      "kind": "comic",
      "when": {
        "m": "name",
        "re": "\\.cbz$"
      }
    },
    {
      "kind": "archive",
      "when": {
        "m": "suffix",
        "suffixes": [
          ".tar.gz",
          ".tgz",
          ".tar.bz2",
          ".tbz2",
          ".tbz",
          ".tar.xz",
          ".txz",
          ".tar.zst",
          ".tzst",
          ".tar",
          ".7z",
          ".7z.001",
          ".zip",
          ".zip.001",
          ".jar",
          ".apk",
          ".nupkg",
          ".whl",
          ".vsix",
          ".cpio",
          ".cpio.gz",
          ".cpgz",
          ".cpio.bz2",
          ".cpio.xz",
          ".cpio.zst",
          ".cpio.lzma",
          ".deb",
          ".udeb",
          ".rpm",
          ".cab",
          ".cbz",
          ".mbox"
        ]
      }
    },
    {
      "kind": "disk_image",
      "when": {
        "m": "suffix",
        "suffixes": [
          ".dmg",
          ".vhdx",
          ".vmdk",
          ".qcow2",
          ".qcow",
          ".vdi",
          ".iso",
          ".wim",
          ".chm",
          ".cbr",
          ".vhd",
          ".img"
        ]
      }
    },
    {
      "kind": "model",
      "when": {
        "m": "name",
        "re": "\\.(gguf|safetensors|pt|pth|ckpt)$|^pytorch_model.*\\.bin$"
      }
    },
    {
      "kind": "pdf",
      "when": {
        "endings": [
          "pdf"
        ],
        "m": "ending"
      }
    },
    {
      "kind": "gpx",
      "when": {
